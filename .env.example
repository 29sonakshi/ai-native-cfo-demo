# Local development configuration. Copy to `.env` and fill in for your workspace.
# (For a deployed Databricks App these are set in app.yaml instead.)
# Local auth uses your Databricks CLI profile — no tokens live in this file.

# Databricks CLI profile to authenticate local runs (see `databricks auth login`).
DATABRICKS_PROFILE=

# SQL Warehouse that backs the app's queries.
WAREHOUSE_ID=

# Unity Catalog location of the demo data (created by setup/01_generate_sample_data.py).
UC_CATALOG=meridian_demo
UC_SCHEMA=meridian_cfo
UC_SCHEMA_AI=meridian_ai

# Genie space id printed by setup/02_create_genie_space.py.
GENIE_SPACE_ID=

# Foundation Model serving endpoint used for AI synthesis / narratives.
SYNTH_MODEL=databricks-claude-sonnet-4-6
